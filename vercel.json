{
  "$schema": "https://vercel.sh",
  "version": 2,
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm --filter @md-ops/shared build && pnpm --filter @md-ops/api prisma generate && pnpm --filter @md-ops/api build",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.9.5"
    }
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:ico|png|jpg|jpeg|gif|svg|css|js)$).*)",
      "destination": "/api/index"
    }
  ]
}
